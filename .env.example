# Docker Compose interpolation. Go itself does not auto-load this file.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
LOG_LEVEL=INFO
DATABASE_PATH=/data/assan.db
# Enable when TLS is terminated by the NAS reverse proxy.
SECURE_COOKIES=true
# Set true only when the API is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=false
